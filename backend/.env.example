NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Validated with the prepared five-task demo; verify availability in your account.
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Optional dedicated detailed-plan model; confirm availability in your account.
NEBIUS_PLAN_MODEL=zai-org/GLM-5.3
# live uses Nebius, replay serves only the known demo case.
TRIAL_MODE=live
NEBIUS_RESPONSE_FORMAT=json_schema
NEBIUS_TIMEOUT_SECONDS=25
CORS_ORIGINS=http://localhost:3000
